<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/widget_icon_ring"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Köpri"
            android:textColor="@color/widget_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ru → tk"
            android:textColor="@color/widget_badge_text"
            android:background="@drawable/widget_badge_bg"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="12dp"
        android:background="@color/widget_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="25dp"
        android:text="Salam dossym!"
        android:textColor="@color/widget_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="58dp"
        android:orientation="horizontal"
        android:gravity="top">

        <TextView
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_accent_bar_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Привет, друг мой!"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</RelativeLayout>