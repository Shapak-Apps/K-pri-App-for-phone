<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_card"
    android:padding="16dp"
    android:elevation="8dp">
    <TextView
        android:id="@+id/bubble_original"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9BA0B4"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#26FFFFFF" />
    <TextView
        android:id="@+id/bubble_translated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="6"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/bubble_copy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/bubble_btn_bg"
            android:src="@drawable/ic_copy" />
        <ImageView
            android:id="@+id/bubble_speak"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/bubble_btn_bg"
            android:src="@drawable/ic_speak" />
        <ImageView
            android:id="@+id/bubble_open"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/bubble_btn_bg"
            android:src="@drawable/ic_open" />
        <ImageView
            android:id="@+id/bubble_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/bubble_btn_bg"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>