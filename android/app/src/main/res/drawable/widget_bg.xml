<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- мягкая тень -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_shadow" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="2dp" />
        </shape>
    </item>
    <!-- градиентный фон -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/widget_bg_start"
                android:centerColor="@color/widget_bg_center"
                android:endColor="@color/widget_bg_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_border" />
        </shape>
    </item>
</layer-list>